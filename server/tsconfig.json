{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/server.tsbuildinfo",
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/**/*.ts", "../src/engine/render.ts", "../src/engine/effects.ts"],
  "exclude": ["src/**/*.test.ts"]
}
