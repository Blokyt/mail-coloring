# Front statique du colorieur — image pour Coolify (VM deploy du Rézal).
# Le build produit dist/ (mêmes fichiers que la prod actuelle VM Web).
FROM node:22-bookworm-slim AS build
WORKDIR /repo
RUN corepack enable
ARG VITE_API_BASE=https://mail-colorer-api.apps.rezal-mdm.com/api/v1
ENV VITE_API_BASE=$VITE_API_BASE
COPY package.json pnpm-lock.yaml ./
COPY src/ ./src/
COPY public/ ./public/
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json vitest.config.ts ./
RUN pnpm install --frozen-lockfile && pnpm run build

FROM nginx:alpine
COPY --from=build /repo/dist /usr/share/nginx/html
EXPOSE 80
