# API du colorieur — image pour Coolify (VM deploy du Rézal).
# Structure identique au repo : /repo/src/engine partagé, /repo/server/compilé.
FROM node:22-bookworm-slim AS build
WORKDIR /repo
RUN corepack enable
# node-gyp de secours si la prebuild better-sqlite3 manque (pnpm epinglE par
# packageManager ; sans ce pin corepack prend sa version par defaut, qui
# refuse les scripts de build et fait echouer l'install)
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY server/ ./server/
COPY src/engine/ ./src/engine/
COPY public/ ./public/
RUN cd server && pnpm install --frozen-lockfile && pnpm build

FROM node:22-bookworm-slim
WORKDIR /repo/server
RUN corepack enable
ENV NODE_ENV=production PORT=8030 HOST=0.0.0.0 DATA_DIR=/data CATALOG_PATH=/repo/public/admin-data.json
COPY --from=build /repo/server/node_modules ./node_modules
COPY --from=build /repo/server/dist ./dist
COPY --from=build /repo/public /repo/public
EXPOSE 8030
VOLUME /data
CMD ["node", "dist/server/src/index.js"]
